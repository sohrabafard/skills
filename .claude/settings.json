{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "BEADS_DIR": "/home/sohrab/project/alaa-task-hub/.beads"
  },
  "permissions": {
    "allow": [
      "Bash(bd where *)",
      "Bash(bd version *)",
      "Bash(bd prime *)",
      "Bash(bd ready *)",
      "Bash(bd list *)",
      "Bash(bd show *)",
      "Bash(bd blocked *)",
      "Bash(bd create *)",
      "Bash(bd update *)",
      "Bash(bd close *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bd prime --hook-json"
          }
        ]
      }
    ]
  }
}
