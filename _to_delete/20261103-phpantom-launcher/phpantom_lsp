#!/usr/bin/env bash
# Small stdio-transparent exec launcher. Not an LSP proxy; stdout is never used.
# Resolution: explicit override > user-local existing binary > PATH excluding self.
set -euo pipefail

say_error() { printf '[alaa-phpantom] ERROR: %s\n' "$*" >&2; exit 127; }
SELF_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"

run_binary() {
  local candidate="$1"
  [[ -f "$candidate" && -x "$candidate" ]] || return 1
  [[ "$(readlink -f -- "$candidate")" != "$(readlink -f -- "${BASH_SOURCE[0]}")" ]] || return 1
  exec "$candidate" "${@:2}"
}

if [[ -n "${PHPANTOM_SERVER_PATH:-}" ]]; then
  run_binary "$PHPANTOM_SERVER_PATH" "$@" || say_error "PHPANTOM_SERVER_PATH is missing, non-executable, or points to this launcher: $PHPANTOM_SERVER_PATH"
fi

if [[ -x "${HOME}/.local/bin/phpantom_lsp" ]]; then
  run_binary "${HOME}/.local/bin/phpantom_lsp" "$@" || true
fi

# Do not resolve ourselves by accident when the plugin's bin/ is on PATH.
IFS=: read -r -a path_parts <<< "${PATH:-}"
for dir in "${path_parts[@]}"; do
  [[ -n "$dir" ]] || continue
  [[ -d "$dir" ]] || continue
  candidate="$dir/phpantom_lsp"
  [[ -f "$candidate" && -x "$candidate" ]] || continue
  [[ "$(readlink -f -- "$candidate")" != "$(readlink -f -- "${BASH_SOURCE[0]}")" ]] || continue
  exec "$candidate" "$@"
done
say_error "PHPantom binary not found. Expected ~/.local/bin/phpantom_lsp or PHPANTOM_SERVER_PATH; no installation was attempted."
