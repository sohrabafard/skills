# Copy this file to a deployment env file (for example tusd-staging.env),
# fill every value, and pass it at RENDER time:
#
#   docker compose --env-file tusd-staging.env -f tusd-staging.compose.yaml config
#   docker compose --env-file tusd-staging.env -f tusd-staging.compose.yaml up -d
#
# Compose interpolates ${VAR} from --env-file or the shell, never from a
# service-level env_file; every mandatory variable is ${VAR:?...} and the
# render aborts when one is missing or empty.
#
# Pin an exact tusd release. There is deliberately no default: the version
# snapshot lives in references/10-source-map.md and nowhere else.
TUSD_IMAGE=
TUSD_BIND_PORT=1081
TUSD_CORS_ALLOW_ORIGIN=https://app.example.com
# Mandatory server-side cap, in bytes.
TUSD_MAX_SIZE=5368709120
TUSD_HOOKS_HTTP=https://hook-service.internal.example.com/tusd/hooks
TUSD_PROGRESS_HOOKS_INTERVAL=2s
TUSD_NETWORK_TIMEOUT=60s
TUSD_SHUTDOWN_TIMEOUT=30s
TUSD_REQUEST_COMPLETION_TIMEOUT=15s
TUSD_ACQUIRE_LOCK_TIMEOUT=20s
