# Pin an exact tusd release. There is deliberately no default: the version
# snapshot lives in references/10-source-map.md and nowhere else.
TUSD_IMAGE=
TUSD_BIND_PORT=1080
TUSD_CORS_ALLOW_ORIGIN=https://app.example.com
# Mandatory server-side cap, in bytes. Set it from the largest file the
# product supports, and make the advertised Tus-Max-Size agree with it.
TUSD_MAX_SIZE=5368709120
TUSD_HOOKS_HTTP=https://hook-service.internal.example.com/tusd/hooks
TUSD_PROGRESS_HOOKS_INTERVAL=2s
TUSD_NETWORK_TIMEOUT=60s
# Must exceed the longest legitimate PATCH and stay below the orchestrator's
# termination grace period.
TUSD_SHUTDOWN_TIMEOUT=30s
TUSD_REQUEST_COMPLETION_TIMEOUT=15s
TUSD_ACQUIRE_LOCK_TIMEOUT=20s
TUSD_S3_BUCKET=uploads
TUSD_S3_ENDPOINT=https://minio.internal.example.com
# Include the tenant or project in the prefix so per-tenant lifecycle rules,
# cost attribution and prefix-scoped credentials remain possible.
TUSD_S3_OBJECT_PREFIX=tenant-a/
TUSD_S3_PART_SIZE=52428800
TUSD_S3_MIN_PART_SIZE=5242880
TUSD_S3_CONCURRENT_PART_UPLOADS=10
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
AWS_REGION=us-east-1
