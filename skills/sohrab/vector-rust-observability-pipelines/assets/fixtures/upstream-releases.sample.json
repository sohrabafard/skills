{
  "_comment": [
    "RED fixture for check-upstream-version.mjs --self-test.",
    "This is a trimmed, real-shaped response from the GitHub releases API for",
    "vectordotdev/vector. The first entry is the trap: the repository also tags",
    "the `vdev` developer tool, and GitHub's /releases/latest endpoint returns",
    "vdev-v0.3.24 rather than a Vector release. A resolver that takes the first",
    "entry, or that trusts /releases/latest, reports Vector 0.3.3 and every",
    "downstream version comparison is then wrong in the safe-looking direction.",
    "Synthetic higher drafts and prereleases must not override the stable product."
  ],
  "releases": [
    { "tag_name": "vdev-v0.3.24", "draft": false, "prerelease": false },
    { "tag_name": "v9.0.0", "draft": false, "prerelease": true },
    { "tag_name": "v8.0.0", "draft": true, "prerelease": false },
    { "tag_name": "nightly", "draft": false, "prerelease": false },
    { "tag_name": "v0.59.0-rc.1", "draft": false, "prerelease": true },
    { "tag_name": "v0.9.0", "draft": false, "prerelease": false },
    { "tag_name": "v0.58.0", "draft": false, "prerelease": false },
    { "tag_name": "v0.57.0", "draft": false, "prerelease": false }
  ],
  "expected_latest": "0.58.0",
  "cases": [
    { "name": "only nonstable releases", "releases": [
      { "tag_name": "v9.0.0", "draft": false, "prerelease": true },
      { "tag_name": "v8.0.0", "draft": true, "prerelease": false },
      { "tag_name": "vdev-v9.0.0", "draft": false, "prerelease": false },
      { "tag_name": "nightly", "draft": false, "prerelease": false }
    ], "expected": null },
    { "name": "missing publication flags fail closed", "releases": [{ "tag_name": "v9.0.0" }], "expected": null },
    { "name": "numeric ordering includes multi-digit patches", "releases": [
      { "tag_name": "v0.58.9", "draft": false, "prerelease": false },
      { "tag_name": "v0.58.10", "draft": false, "prerelease": false }
    ], "expected": "0.58.10" },
    { "name": "chart tags are a separate product", "chart": true, "releases": [
      { "tag_name": "v9.0.0", "draft": false, "prerelease": false },
      { "tag_name": "vector-0.59.0", "draft": false, "prerelease": true },
      { "tag_name": "vector-0.58.0", "draft": false, "prerelease": false }
    ], "expected": "0.58.0" }
  ]
}
