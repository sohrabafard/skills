
{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "^apply_patch$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/scripts/codex-php-lint.py\"",
            "timeout": 20,
            "statusMessage": "Checking PHP syntax"
          }
        ]
      }
    ]
  }
}
