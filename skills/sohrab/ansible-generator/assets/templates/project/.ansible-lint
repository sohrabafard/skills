---
# ansible-lint configuration for this project.
#
# OWNER: ansible-validator (/ansible-validator, $ansible-validator), at its
# assets/.ansible-lint. This file is a copy of that one. Do not edit it here.
# Change it in ansible-validator, where scripts/check_assets.sh proves that
# every rule named in enable_list still fires on a fixture built to violate it,
# then copy the result back. A second, divergent fork of this file is how a
# project ends up with a lint result that depends on which copy an agent picked.
#
# The 267-line version this scaffold shipped until 2026-07-29 was rejected
# outright by ansible-lint with exit 3 ("'severity' was unexpected", from a
# per-rule severity block that is not a supported option), so every scaffolded
# project was unlintable until a human deleted 113 lines of it.
# ansible-lint configuration owned by ansible-validator.
#
# This is the pair's single ansible-lint configuration. ansible-generator
# (/ansible-generator, $ansible-generator) does not ship one; its project
# scaffold copies this file and names this skill as the owner in a header
# comment. Two forks of one config, configured
# differently for the same repository, means the result depends on which one an
# agent happened to pick.
#
# Verified 2026-07-29 against ansible-lint 26.6.0. Re-derive the rule list with
#   ansible-lint -L
# and the profile list with
#   ansible-lint --help | grep -- --profile
# scripts/check_assets.sh asserts that every rule named in enable_list below
# actually fires on the fixture built to violate it. Run it after any edit here.

# Profiles, from least to most strict: min, basic, moderate, safety, shared,
# production. production is the bar for anything that reaches a managed host.
profile: production

# offline: true keeps ansible-lint from reaching the network mid-validation,
# which is the correct setting in a locked-down runner. Set it to false only
# when the run must resolve a collection it does not have.
offline: true

exclude_paths:
  - .git/
  - .github/
  - venv/
  - .venv/
  - __pycache__/
  - '*.pyc'
  - .molecule/
  - .cache/
  - .tox/
  # test/roles/ holds vendored third-party roles that this skill does not own
  # and does not lint. test/playbooks/ and test/fixtures/ are this skill's own
  # fixtures and are deliberately NOT excluded: a fixture corpus that the lint
  # config hides is a corpus that proves nothing.
  - test/roles/

# Empty. A rule this skill wants off belongs in warn_list with the reason, so
# that the finding is still visible.
skip_list: []

# Rules this configuration turns on beyond the profile default. Each one is
# covered by a fixture under test/fixtures/lint/ and asserted by
# scripts/check_assets.sh.
enable_list:
  - name[missing]        # every task is named
  - name[casing]         # task names start with a capital letter
  - fqcn[action-core]    # every action is fully qualified
  - no-changed-when      # command and shell state their changed condition
  - no-handler           # a service restart goes through a handler
  - var-naming           # variables are snake_case and role-prefixed
  - no-log-password      # a task handling a password sets no_log
  - risky-file-permissions  # a file task states an explicit mode

# Rules that report without failing the run. name[casing] is deliberately NOT
# here: it is in enable_list above, and listing a rule in both places is a
# contradiction the reader has to resolve.
warn_list:
  - yaml[line-length]    # long lines are legible; broken YAML is not
  - role-name            # a vendored role's name is not this project's to fix
  - galaxy[tags]         # galaxy_tags matter at publication, not at apply time

# Task naming.
#
# task_name_prefix takes {stem}, the file stem, and nothing else. The value
# "{path}:" was shipped here until 2026-07-29; {path} is not a valid
# substitution key, ansible-lint caught the resulting KeyError, printed
# "Ignored exception from NameRule.matchtasks" and continued with NameRule
# dead. Measured on test/playbooks/bad-playbook.yml: 19 failures and zero
# name[missing] with that line, 21 failures and two name[missing] without it.
# The config disabled the two rules its own enable_list asked for.
#
# No prefix is enforced now. To enforce one, use {stem} and add a fixture to
# test/fixtures/lint/ so scripts/check_assets.sh can prove it fires:
# task_name_prefix: "{stem} | "

# Variables are snake_case, and a role's variables carry the role name as a
# prefix. references/best_practices.md states the naming rule; this makes it
# reportable.
var_naming_pattern: '^[a-z_][a-z0-9_]*$'

# Modules that may not be installed in the validation environment. A mocked
# module is a module ansible-lint will not resolve; keep this list to what the
# project actually uses and declare the rest in requirements.yml instead.
mock_modules:
  - community.general.ufw

# loop_var_prefix configures the loop-var-prefix rule, which is opt-in. Setting
# the option without enabling the rule does nothing, which is what this file did
# before 2026-07-29. Enable the rule alongside it if you want it enforced:
# enable_list:
#   - loop-var-prefix
# loop_var_prefix: "{role}_"

# SARIF output for a code-scanning gate. The two aggregate scripts pass
# --format json themselves; set this when ansible-lint is invoked directly from
# a CI job that uploads SARIF. /alaa-gitlab-ci-cd ($alaa-gitlab-ci-cd) owns
# where the artifact goes and how long it is retained.
# sarif_file: ansible-lint.sarif
