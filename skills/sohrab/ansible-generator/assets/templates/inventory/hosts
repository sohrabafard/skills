# Inventory: CHANGE_ME_environment
# INI format. Use YAML instead when the group hierarchy is deep enough that the
# [group:children] blocks stop being readable.
#
# One inventory directory per environment. Sharing one inventory between
# production and staging and switching on a variable means a mistyped --limit
# reaches production.

[webservers]
web1.example.com ansible_host=192.0.2.10
web2.example.com ansible_host=192.0.2.11

[databases]
db1.example.com ansible_host=192.0.2.20
db2.example.com ansible_host=192.0.2.21

[loadbalancers]
lb1.example.com ansible_host=192.0.2.30

[production:children]
webservers
databases
loadbalancers

# Group variables belong in group_vars/ where they can carry comments and
# structure. Keep this block for values that must be visible beside the hosts.
[production:vars]
env=production
