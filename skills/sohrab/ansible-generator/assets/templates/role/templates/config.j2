# Configuration for {{ ROLE_NAME_service_name }}
# Managed by Ansible. Edits made by hand are overwritten on the next run.
# Rendered on {{ ansible_date_time.iso8601 | default('an ungathered host') }}
# Host: {{ inventory_hostname }}

[service]
port = {{ ROLE_NAME_port }}
bind_address = {{ ROLE_NAME_bind_address }}
max_connections = {{ ROLE_NAME_max_connections }}

{% if ROLE_NAME_enable_ssl %}
[tls]
enabled = true
certificate = {{ ROLE_NAME_ssl_cert }}
private_key = {{ ROLE_NAME_ssl_key }}
{% endif %}

[logging]
directory = {{ ROLE_NAME_log_dir }}
level = {{ ROLE_NAME_log_level | default('info') }}

[data]
directory = {{ ROLE_NAME_data_dir }}
