{
  "corpus_name": "alaa-permission-bitmap",
  "corpus_version": 1,
  "owner_skill": "alaa-permission-generator",
  "corpus_sha256": "812623e38d32436e67c58b7eaf62bfb44a067be2d230830bcf93cbf48af615a7",
  "corpus_sha256_recipe": "sha256 over json.dumps(cases, sort_keys=True, separators=(\",\",\":\"), ensure_ascii=False) encoded UTF-8, with no trailing newline",
  "contract": {
    "id_base": "permission ids are 1-based and bit_index equals bitmap_id minus 1",
    "bit_order": "bits are packed least-significant-bit first within each byte, so id 1 is bit 0 of byte 0, id 8 is bit 7 of byte 0, and id 9 is bit 0 of byte 1",
    "id_formula": "permission_id = byte_index * 8 + bit_index + 1",
    "wire_format": "raw bytes in unpadded base64url, with no padding character and with the unused low-order bits of the final character required to be zero",
    "unknown_bits": "a set bit whose id exceeds this consumer's own maximum, or that has no entry in this consumer's map, is dropped silently and is not an error",
    "fail_closed": "a server-side protected request resolving to zero known permissions is rejected; a browser client deriving unverified UI hints treats an empty set as a legitimate ready state instead",
    "error_precedence": "empty_bitmap, then invalid_decode_bound, then bitmap_too_long, then invalid_bitmap, then no_known_permissions",
    "default_max_encoded_length": 1024
  },
  "operations": {
    "decode_ids": "decode the bitmap to permission ids; driver answer is OK| followed by the ids joined with commas, or ERR| followed by the error code",
    "decode_set": "decode the bitmap to the permission names in names_by_id; driver answer is OK| followed by the names sorted and joined with commas, or ERR| followed by the error code",
    "has": "answer whether the bitmap grants permission; driver answer is OK|true or OK|false and never an error, because this entry point fails closed. A has case sets max_permission_id to the highest id in names_by_id and leaves max_encoded_length null, so an implementation whose convenience wrapper derives the bound from the map answers the same as one taking it explicitly."
  },
  "fields": {
    "max_encoded_length": "null means the implementation's default-cap entry point is exercised rather than an explicit cap"
  },
