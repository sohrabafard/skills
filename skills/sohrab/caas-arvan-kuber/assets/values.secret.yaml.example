# Example secret values file for Helm charts targeting Arvan CaaS
# DO NOT COMMIT THIS FILE.
#
# Suggested filename: values.secret.yaml
#
# Add to .gitignore:
#   values.secret.yaml
#   *.secret.yaml
#   *.secrets.yaml

# -----------------------------------------------------------------------------
# Runtime app credentials (example)
# -----------------------------------------------------------------------------
appSecrets:
  enabled: true
  create: true
  existingSecretName: ""   # set and switch create=false when reusing existing secret
  items:
    - name: "DATABASE_PASSWORD"
      value: "REPLACE_ME"
    - name: "JWT_SIGNING_KEY"
      value: "REPLACE_ME"

# -----------------------------------------------------------------------------
# Private registry credentials (imagePullSecrets)
# Support both create and existing-secret modes.
# -----------------------------------------------------------------------------
privateRegistry:
  enabled: true
  create: true
  existingSecretName: ""   # when set, use create=false
  secretName: ""           # optional override; default should be "<release>-registry"
  server: "registry.example.com"
  username: "REPLACE_ME"
  password: "REPLACE_ME"
  email: ""
  # Optional: provide full Docker config JSON instead of username/password.
  # dockerconfigjson: |
  #   {"auths":{"registry.example.com":{"username":"...","password":"..."}}}

# -----------------------------------------------------------------------------
# GitLab Runner auth (optional example)
# -----------------------------------------------------------------------------
runnerAuth:
  enabled: false
  create: true
  existingSecretName: ""   # when set, use create=false
  runnerToken: "REPLACE_ME"
  runnerRegistrationToken: ""

