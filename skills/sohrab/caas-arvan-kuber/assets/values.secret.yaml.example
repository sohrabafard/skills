# Example secret values file for a Helm chart targeting Arvan CaaS.
#
# DO NOT COMMIT THIS FILE, and do not commit anything derived from it.
#
# Suggested filename: values.secret.yaml
#
# Add every one of these to .gitignore BEFORE the first render. The last three
# matter because `helm template` and `helm get manifest` write the decoded
# contents of this file into the rendered output, so a rendered manifest is as
# sensitive as this file is:
#
#   values.secret.yaml
#   *.secret.yaml
#   *.secrets.yaml
#   rendered.yaml
#   *.rendered.yaml
#   build/rendered.yaml
#
# scripts/render-helm.sh creates its output with mode 0600 and deletes it on
# exit unless --keep is passed. Fail-closed doctrine for an artifact that holds
# a decoded secret is owned by /alaa-security-review ($alaa-security-review).

# -----------------------------------------------------------------------------
# Runtime application credentials
# -----------------------------------------------------------------------------
appSecrets:
  enabled: true
  create: true
  existingSecretName: ""   # set this and switch create=false to reuse a Secret the platform already holds
  items:
    - name: "DATABASE_PASSWORD"
      value: "REPLACE_ME"
    - name: "JWT_SIGNING_KEY"
      value: "REPLACE_ME"

# -----------------------------------------------------------------------------
# Private registry credentials, used as imagePullSecrets.
# Both modes are supported; pick exactly one.
# -----------------------------------------------------------------------------
privateRegistry:
  enabled: true
  create: true
  existingSecretName: ""   # when set, switch create=false
  secretName: ""           # optional override; the chart default is "<release>-registry"
  server: "registry.example.com"
  username: "REPLACE_ME"
  password: "REPLACE_ME"
  email: ""
  # Alternative to username and password: a complete Docker config document.
  # dockerconfigjson: |
  #   {"auths":{"registry.example.com":{"username":"...","password":"..."}}}

# -----------------------------------------------------------------------------
# GitLab Runner authentication, when this chart deploys a runner.
#
# Use `runnerToken`: it holds a runner AUTHENTICATION token, which GitLab prints
# with a `glrt-` prefix. The older registration-token workflow is deprecated,
# and from GitLab 17.0 an administrator or group owner can disable it entirely,
# after which registration fails with `410 Gone - runner registration
# disallowed`. There is no field here for a registration token, deliberately.
#
# The runner's own configuration - the [runners.kubernetes] block, image pull
# secrets, the helper image - is owned by /alaa-gitlab-ci-cd
# ($alaa-gitlab-ci-cd), not by this file.
# -----------------------------------------------------------------------------
runnerAuth:
  enabled: false
  create: true
  existingSecretName: ""   # when set, switch create=false
  runnerToken: "REPLACE_ME"
