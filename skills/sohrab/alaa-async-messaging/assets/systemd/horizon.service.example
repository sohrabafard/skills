# systemd service: Laravel Horizon
# Place as: /etc/systemd/system/laravel-horizon.service
# Then: systemctl daemon-reload && systemctl enable --now laravel-horizon
#
# Deploy: run `php artisan horizon:terminate` so systemd restarts it on new code.

[Unit]
Description=Laravel Horizon
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/var/www/app
ExecStart=/usr/bin/php /var/www/app/artisan horizon
Restart=always
RestartSec=3
TimeoutStopSec=3600
KillSignal=SIGTERM
Environment=APP_ENV=production
Environment=APP_DEBUG=false

[Install]
WantedBy=multi-user.target
