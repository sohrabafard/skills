; Supervisor program: Laravel queue worker consuming RabbitMQ via queue:work
; This is the most compatible approach (Laravel native command).
;
; Replace /var/www/app with your Laravel project path.
; Recommended: one program per queue group with dedicated concurrency.

[program:laravel-queue-rabbitmq]
process_name=%(program_name)s_%(process_num)02d
command=php /var/www/app/artisan queue:work rabbitmq --queue=default --sleep=1 --tries=3 --timeout=120 --memory=256
directory=/var/www/app
autostart=true
autorestart=true
user=www-data
numprocs=4
stopsignal=TERM
stopwaitsecs=3600
killasgroup=true
stopasgroup=true
redirect_stderr=true
stdout_logfile=/var/www/app/storage/logs/queue-rabbitmq.log
stdout_logfile_maxbytes=50MB
stdout_logfile_backups=5
environment=APP_ENV="production",APP_DEBUG="false",QUEUE_CONNECTION="rabbitmq"
