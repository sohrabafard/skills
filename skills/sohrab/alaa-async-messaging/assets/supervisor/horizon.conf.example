; Supervisor program: Laravel Horizon
; Replace /var/www/app with your Laravel project path.
;
; Start:  supervisorctl reread && supervisorctl update && supervisorctl restart laravel-horizon
; Deploy: php artisan horizon:terminate (graceful) then supervisor restarts it.

[program:laravel-horizon]
process_name=%(program_name)s
command=php /var/www/app/artisan horizon
directory=/var/www/app
autostart=true
autorestart=true
user=www-data
stopsignal=TERM
stopwaitsecs=3600
killasgroup=true
stopasgroup=true
redirect_stderr=true
stdout_logfile=/var/www/app/storage/logs/horizon.log
stdout_logfile_maxbytes=50MB
stdout_logfile_backups=5
environment=APP_ENV="production",APP_DEBUG="false"
