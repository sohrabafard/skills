              "raw": "{{base_url}}/v1/other?mode=variant",
              "host": ["{{base_url}}"],
              "path": ["v1", "other"]
            }
          },
          "code": 200,
          "status": "OK",
          "header": [],
          "body": "{}"
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "https://api.example.test"
    }
  ]
