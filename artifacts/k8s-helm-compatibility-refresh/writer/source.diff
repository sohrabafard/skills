+helm_version=$(helm version --template '{{.Version}}') || exit 2
+case "$helm_version" in
+  v3.*) rb=--atomic ;;
+  v4.*) rb=--rollback-on-failure ;;
+  *) printf 'Unsupported Helm version: %s\n' "$helm_version" >&2; exit 2 ;;
